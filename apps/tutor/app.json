{
  "expo": {
    "name": "PetLive",
    "slug": "petlive-tutor",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "petlive",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.petlive.tutor",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O PetLive usa sua localização para mostrar clínicas, petshops e banho e tosa perto de você.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O PetLive usa sua localização para avisar serviços próximos e manter o mapa atualizado."
      }
    },
    "android": {
      "package": "app.petlive.tutor",
      "adaptiveIcon": {
        "backgroundColor": "#A9DCF6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A9DCF6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O PetLive acessa suas fotos para você colocar uma imagem no seu pet.",
          "cameraPermission": "O PetLive usa a câmera para você fotografar o seu pet.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
