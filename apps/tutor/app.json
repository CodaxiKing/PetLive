{
  "expo": {
    "name": "PetLive",
    "slug": "petlive-tutor",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo-petlive-original.png",
    "scheme": "petlive",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.petlive.tutor",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O PetLive usa sua localização para mostrar clínicas, petshops e banho e tosa perto de você.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O PetLive usa sua localização para avisar serviços próximos e manter o mapa atualizado."
      }
    },
    "android": {
      "package": "app.petlive.tutor",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logo-petlive-original.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/logo-petlive-original.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "O PetLive usa a câmera para fotografar seu pet e documentos de saúde.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A9DCF6",
          "image": "./assets/logo-petlive-original.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O PetLive acessa suas fotos para você colocar uma imagem no seu pet.",
          "cameraPermission": "O PetLive usa a câmera para fotografar seu pet e documentos de saúde.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "@sentry/react-native",
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/apps-de-mapa",
      "./plugins/atalhos-android",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ProximaDose",
              "label": "Próxima dose",
              "description": "A próxima dose ou vacina do pet, com o botão Feito",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fbdd71fe-7183-4d55-85e4-310e959f6b1d"
      }
    },
    "owner": "codaxi",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/fbdd71fe-7183-4d55-85e4-310e959f6b1d",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
