{
  "expo": {
    "name": "PetLive",
    "slug": "petlive-tutor",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "petlive",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.petlive.tutor",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O PetLive usa sua localização para mostrar clínicas, petshops e banho e tosa perto de você.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O PetLive usa sua localização para avisar serviços próximos e manter o mapa atualizado."
      }
    },
    "android": {
      "package": "app.petlive.tutor",
      "adaptiveIcon": {
        "backgroundColor": "#A9DCF6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A9DCF6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O PetLive acessa suas fotos para você colocar uma imagem no seu pet ou anexar o cartão de vacina e exames.",
          "cameraPermission": "O PetLive usa a câmera para você fotografar o seu pet, o cartão de vacina e exames.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "@sentry/react-native",
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/apps-de-mapa"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fbdd71fe-7183-4d55-85e4-310e959f6b1d"
      }
    },
    "owner": "codaxi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fbdd71fe-7183-4d55-85e4-310e959f6b1d"
    }
  }
}
