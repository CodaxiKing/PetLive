# Credenciais do Supabase do app do tutor.
# Copie para `.env` e preencha com as chaves do seu projeto.
# No Supabase: Project Settings > API.
#
# Supabase local (sem criar o projeto remoto): `npx supabase start` sobe tudo
# em http://127.0.0.1:54321 e mostra a ANON_KEY no fim da saída; o Studio em
# http://127.0.0.1:54323 repete as duas. Os e-mails de confirmação caem no
# Mailpit (http://127.0.0.1:54324).
#
# NUNCA commite o `.env`. As variáveis públicas do Expo precisam do
# prefixo EXPO_PUBLIC_ para irem para o bundle; a anon key é pública
# por design (o RLS é quem protege os dados).

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=COLE_A_ANON_KEY

# Sentry (monitoramento de erros) — opcional.
# Sem a DSN o app roda normalmente, apenas sem enviar erros.
# Crie a conta/conta e o projeto em sentry.io, copie a DSN
# (Settings > Projects > Client Keys) e cole aqui.
# Nos builds EAS as source maps sobem com SENTRY_AUTH_TOKEN como
# SEGREDO do EAS (+ SENTRY_ORG e SENTRY_PROJECT) — nunca commitado.
EXPO_PUBLIC_SENTRY_DSN=

# Fonte dos lugares do mapa: "osm" (padrão, dados do OpenStreetMap) ou
# "google" (Edge Functions places-*). Só ligue "google" junto com o mapa do
# Google na tela: os termos do Google exigem que o conteúdo dele apareça
# num mapa do Google.
EXPO_PUBLIC_LUGARES_FONTE=osm

# Mapa do Google (Maps SDK). Lidas pelo app.config.js NO BUILD (segredos do
# EAS em produção); só valem junto com EXPO_PUBLIC_LUGARES_FONTE=google.
# Sem elas, o mapa é o do OpenStreetMap. Mudar exige build nativo novo.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
