# Variáveis de ambiente locais para `supabase functions serve --env-file supabase/.env`.
# Copie para `supabase/.env` e preencha. Este arquivo afeta só o functions serve
# local; em produção os segredos ficam no Supabase (`npx supabase secrets set`).
# Nunca commite valores reais.

# Chave do Google restrita apenas à Places API (New). No servidor pode ser
# restringida pelos IPs de saída do Supabase (quando fixos).
GOOGLE_PLACES_KEY=chave-teste

# Para testar sem chave real, rode o servidor que imita o Google
# (node supabase/tests/google-falso.mjs, porta 8787) e aponte para ele:
GOOGLE_PLACES_BASE_URL=http://host.docker.internal:8787
